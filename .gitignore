/target
*.ppm
*.png

# Sensor captures and anything derived from them are private to the user's
# scene and must never be committed. Tuning data in data/ is sensor tuning
# data, not a scene capture, and is tracked.
/tests/data/*
!/tests/data/.gitkeep

__pycache__/

# capture binary built in container, copied to host for running
/gc2607-capture
/gc2607-video

# timestamped backups of the host-deployed binaries before a redeploy
*.bak-*

# local project-check review reports (generated, not part of the source)
/docs/reviews/

# Debian packaging build artefacts
/debian/.debhelper/
/debian/files
/debian/*.substvars
/debian/*.debhelper
/debian/*.debhelper.log
/debian/debhelper-build-stamp
/debian/gc2607-isp/
/debian/tmp/

# CI deb collection
/dist/
